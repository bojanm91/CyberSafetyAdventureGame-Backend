# PostgreSQL connection string
# Railway:    postgresql://postgres:PASSWORD@HOST:PORT/railway
# Neon:       postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Supabase:   postgresql://postgres:password@db.XXX.supabase.co:5432/postgres
# Local:      postgresql://postgres:password@localhost:5432/csag_db
DATABASE_URL=postgresql://postgres:password@localhost:5432/csag_db

# JWT secret - change this to a long random string in production
JWT_SECRET=change-this-to-a-very-long-random-secret-string

# Port for the backend server
PORT=4000

# Set to 'production' on Railway/cloud
NODE_ENV=development

# Hugging Face — Bajt koristi LLM da generiše zanimljivu činjenicu pri prijavi.
# Token sa https://huggingface.co/settings/tokens (Read je dovoljan).
# Ako je prazno, koristi se ugrađena lista činjenica (fallback) — sve i dalje radi.
HUGGINGFACE_API_KEY=
# Model na HF Inference routeru (OpenAI-kompatibilan chat endpoint).
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
